{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "poap.thingelstad.xyz HTTPS certificate with external DNS validation",
  "Resources": {
    "Certificate": {
      "Type": "AWS::CertificateManager::Certificate",
      "Properties": {
        "DomainName": "poap.thingelstad.xyz",
        "ValidationMethod": "DNS"
      }
    }
  },
  "Outputs": {
    "CertificateArn": {
      "Value": { "Ref": "Certificate" },
      "Description": "poap.thingelstad.xyz HTTPS certificate"
    }
  }
}
