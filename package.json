{
  "name": "poap.thingelstad.xyz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "POAP: Proof of a Person. Jamie Thingelstad's POAP time capsule, 2021 to 2026.",
  "author": "Jamie Thingelstad",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint src tools tests *.mjs --max-warnings 0",
    "format": "prettier --write src tools tests infra .github *.mjs *.json .prettierrc.json README.md AGENTS.md HANDOFF.md docs design",
    "format:check": "prettier --check src tools tests infra .github *.mjs *.json .prettierrc.json README.md AGENTS.md HANDOFF.md docs design",
    "validate:data": "node tools/validate-data.mjs",
    "validate:infra": "node tools/validate-infra.mjs",
    "validate:site": "python3 tools/validate-site.py",
    "media:build": "node tools/build-media.mjs",
    "media:publish": "node tools/media.mjs publish",
    "media:verify": "node tools/media.mjs verify",
    "media:snapshot": "node tools/media.mjs snapshot",
    "revision": "node tools/write-revision.mjs",
    "test:ci-browser": "node tools/test-built-site.mjs",
    "deploy": "node tools/deploy.mjs",
    "infra:plan": "node tools/bootstrap-infra.mjs plan",
    "infra:apply": "node tools/bootstrap-infra.mjs apply",
    "infra:attach": "node tools/bootstrap-infra.mjs attach"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "sharp": "0.35.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudfront": "3.1150.0",
    "@aws-sdk/client-s3": "3.1150.0",
    "@aws-sdk/client-sts": "3.1150.0",
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "playwright": "^1.64.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript-eslint": "8.71.2",
    "@aws-sdk/client-cloudformation": "3.1150.0",
    "@aws-sdk/client-acm": "3.1150.0"
  },
  "engines": {
    "node": ">=22"
  }
}
