---
// One kudos control per drop, keyed on the drop's canonical path so cards and
// the drop page count together. Counts stay private (data-private).
interface Props {
  path: string;
  title: string;
  compact?: boolean;
}
const { path, title, compact = false } = Astro.props;
---

<button
  class:list={['tinylytics_kudos', 'kudos', { compact }]}
  data-path={path}
  data-private="true"
  aria-label={`Give kudos to ${title}`}
  title={`Give kudos to ${title}`}
></button>
